# Cloudflare Pages header rules. Copied verbatim into dist/ by Vite.
# First matching rule wins per header, so keep the specific paths above /*.

# Vite fingerprints these filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Model URLs are not fingerprinted. Revalidate replacements on each visit.
/models/*
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/characters.html
  Cache-Control: no-cache

/animations/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/hdri/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
